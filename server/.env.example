PORT=4000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veripay

# JWT signing secret - use a long random string
JWT_SECRET=replace_with_a_long_random_string

# Google Gemini Vision API key, for OCR extraction from receipt screenshots
GEMINI_API_KEY=replace_with_your_gemini_key

# ------------------------------------------------------------
# Bank/telecom receipt verification
# ------------------------------------------------------------
# No API key needed - verification calls each bank's own public receipt
# endpoint directly (see server/src/services/providers/). These optional
# overrides are only for CBE's newer token-based JSON API; the defaults
# below work for the vast majority of receipts and rarely need changing.
# CBE_APP_ID=
# CBE_APP_VERSION=
#
# NOTE: the M-Pesa (Safaricom Ethiopia) endpoint only accepts requests from
# Ethiopia/Kenya IP ranges. If this server is hosted elsewhere, M-Pesa
# verification will typically fail with a connection/timeout error - that's
# a hosting limitation, not a bug.

# ------------------------------------------------------------
# Chapa Payment Integration (for wallet top‑up)
# ------------------------------------------------------------
CHAPA_SECRET_KEY=your_chapa_secret_key_here

# Optional but strongly recommended: set the same secret in your Chapa
# dashboard's Webhooks tab. When set, incoming webhook requests are
# verified via HMAC signature (x-chapa-signature) before anything is
# credited. Without it, the webhook still works (Chapa's own
# transaction/verify API is always re-checked before crediting either way)
# but an attacker who discovers the webhook URL could at least trigger
# wasted verify calls.
CHAPA_WEBHOOK_SECRET=set_this_and_match_it_in_the_chapa_dashboard
# "test" while using a Chapa sandbox/test secret key, "live" in production.
# Used to reject verify responses whose mode doesn't match (e.g. a test
# payment should never credit DU PT on a live deployment).
CHAPA_MODE=test

# Base URL of your backend (used for Chapa's callback_url)
BASE_URL=http://localhost:4000

# Base URL of your frontend (for redirect after payment)
FRONTEND_URL=http://localhost:5173